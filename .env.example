# ============================================================
# DogEar 환경 변수 예시
# 이 파일을 .env 로 복사하고 실제 값을 채워 주세요
# .env 는 git에 커밋하지 않습니다
# ============================================================

# Supabase — 프로젝트 설정 > API 에서 확인
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OAuth — Apple/Google 로그인 설정
EXPO_PUBLIC_APPLE_CLIENT_ID=com.your.bundle.id
# Google Cloud Console > API & Services > Credentials > OAuth 2.0 Client IDs (Web)
# Android 빌드는 별도로 Android OAuth Client ID도 필요 (SHA-1 등록 필수)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# 카카오 로그인 — Kakao Developers > 내 애플리케이션 > 앱 키 > 네이티브 앱 키
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=your-kakao-native-app-key

# 카카오맵 — Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
# 플랫폼 등록: Web 도메인 (dogear-demo.vercel.app, localhost) + Android 패키지명/키해시
EXPO_PUBLIC_KAKAO_JS_KEY=your-kakao-javascript-key

# Sentry (에러 추적, Phase 2+)
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
