{
  "expo": {
    "name": "DogEar",
    "slug": "dogear-app",
    "version": "1.0.0",
    "scheme": "dogear",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.factorial9.dogear",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "주변 산책 장소를 찾고 발도장에 위치 정보를 기록하기 위해 위치 정보가 필요해요. 권한을 거부해도 앱의 다른 기능은 사용할 수 있어요.",
        "NSCameraUsageDescription": "발도장 기록에 직접 촬영한 사진을 추가하려면 카메라 접근이 필요해요. 사진은 발도장 메모에만 사용되며 외부로 공유되지 않아요.",
        "NSPhotoLibraryUsageDescription": "발도장 기록과 강아지 프로필에 사진을 추가하려면 사진 라이브러리 접근이 필요해요. 선택한 사진만 앱이 사용해요.",
        "NSPhotoLibraryAddUsageDescription": "발도장 사진을 사진 라이브러리에 저장하려면 권한이 필요해요.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.factorial9.dogear",
      "allowBackup": false,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "ACCESS_BACKGROUND_LOCATION",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ],
      "versionCode": 4
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 산책 장소를 찾고 발도장에 위치 정보를 기록하기 위해 위치 정보가 필요해요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "발도장 기록과 강아지 프로필에 사진을 추가하려면 사진 라이브러리 접근이 필요해요.",
          "cameraPermission": "발도장 기록에 직접 촬영한 사진을 추가하려면 카메라 접근이 필요해요."
        }
      ],
      "expo-apple-authentication",
      "expo-font",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C47848",
          "defaultChannel": "default"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "8dfd3d035c15b72d4ed49561d2232b61"
        }
      ],
      [
        "@react-native-seoul/naver-login",
        {
          "urlScheme": "dogear"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://seungil-choi.github.io/dogear-app/legal/privacy-policy.html",
      "termsUrl": "https://seungil-choi.github.io/dogear-app/legal/terms.html",
      "locationTermsUrl": "https://seungil-choi.github.io/dogear-app/legal/location-terms.html",
      "supportEmail": "support@9factorial.com",
      "router": {},
      "eas": {
        "projectId": "d51c4ee9-4c9d-4933-bec4-0588a9c8ee43"
      }
    },
    "owner": "seungil-choi",
    "updates": {
      "url": "https://u.expo.dev/d51c4ee9-4c9d-4933-bec4-0588a9c8ee43"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
