{
  "expo": {
    "name": "DogEar",
    "slug": "dogear-app",
    "version": "1.0.0",
    "scheme": "dogear",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.factorial9.dogear",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "주변 산책 장소를 찾고, 고르신 장소 근처에 계신지 확인해 발도장을 남기는 데에만 사용해요. 이동 경로는 저장하지 않고 백그라운드에서는 수집하지 않아요. 권한을 거부하셔도 검색과 장소 조회 등 다른 기능은 사용하실 수 있어요.",
        "NSCameraUsageDescription": "발도장과 강아지 프로필에 직접 촬영한 사진을 올릴 때 카메라를 사용해요. 장소에 올린 사진은 그 장소를 보는 다른 이용자에게도 보여요.",
        "NSPhotoLibraryUsageDescription": "발도장과 강아지 프로필에 사진을 올릴 때 사용해요. 고르신 사진만 앱이 읽고, 장소에 올린 사진은 그 장소를 보는 다른 이용자에게도 보여요.",
            "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.factorial9.dogear",
      "allowBackup": false,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "ACCESS_BACKGROUND_LOCATION",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "versionCode": 9
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 산책 장소를 찾고, 고르신 장소 근처에 계신지 확인해 발도장을 남기는 데에만 사용해요. 이동 경로는 저장하지 않고 백그라운드에서는 수집하지 않아요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "발도장과 강아지 프로필에 사진을 올릴 때 사용해요. 고르신 사진만 앱이 읽고, 장소에 올린 사진은 그 장소를 보는 다른 이용자에게도 보여요.",
          "cameraPermission": "발도장과 강아지 프로필에 직접 촬영한 사진을 올릴 때 카메라를 사용해요. 장소에 올린 사진은 그 장소를 보는 다른 이용자에게도 보여요."
        }
      ],
      "expo-apple-authentication",
      "expo-font",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C47848",
          "defaultChannel": "default"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "8dfd3d035c15b72d4ed49561d2232b61",
          "ios": {
            "handleKakaoOpenUrl": true
          }
        }
      ],
      [
        "@react-native-seoul/naver-login",
        {
          "urlScheme": "dogear"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          },
          "ios": {
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://seungil-choi.github.io/dogear-app/legal/privacy-policy.html",
      "termsUrl": "https://seungil-choi.github.io/dogear-app/legal/terms.html",
      "locationTermsUrl": "https://seungil-choi.github.io/dogear-app/legal/location-terms.html",
      "supportEmail": "support@9factorial.com",
      "router": {},
      "eas": {
        "projectId": "d51c4ee9-4c9d-4933-bec4-0588a9c8ee43"
      }
    },
    "owner": "seungil-choi",
    "updates": {
      "url": "https://u.expo.dev/d51c4ee9-4c9d-4933-bec4-0588a9c8ee43"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
