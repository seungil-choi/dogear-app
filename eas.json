{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEV_SEED": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEV_SEED": "true"
      }
    },
    "preview-real": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEV_SEED": "false",
        "EXPO_PUBLIC_KAKAO_JS_KEY": "034f48bf73783dcd6f97dcba1f6ba572",
        "EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY": "8dfd3d035c15b72d4ed49561d2232b61"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_DEV_SEED": "false",
        "EXPO_PUBLIC_KAKAO_JS_KEY": "034f48bf73783dcd6f97dcba1f6ba572",
        "EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY": "8dfd3d035c15b72d4ed49561d2232b61"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
